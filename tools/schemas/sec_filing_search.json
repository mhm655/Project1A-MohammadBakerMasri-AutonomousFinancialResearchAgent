{
  "name": "sec_filing_search",
  "description": "Retrieve an official SEC EDGAR filing for a US-listed company: annual report (10-K), quarterly report (10-Q), material-event report (8-K) or proxy statement (DEF 14A). Use it for authoritative regulatory disclosures such as risk factors, MD&A and audited results. Returns the filing's sections, filing date and accession number.",
  "parameters": {
    "type": "object",
    "properties": {
      "ticker": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9.\\-]{0,9}$",
        "description": "Stock ticker symbol, e.g. AAPL or MSFT."
      },
      "filing_type": {
        "type": "string",
        "enum": ["10-K", "10-Q", "8-K", "DEF 14A"],
        "description": "Type of SEC filing to retrieve."
      },
      "year": {
        "type": "integer",
        "minimum": 1994,
        "maximum": 2100,
        "description": "Fiscal year of the report. Omit for the most recent filing."
      }
    },
    "required": ["ticker", "filing_type"],
    "additionalProperties": false
  },
  "x-ara": {
    "handlers": {
      "mock": "tools.sec_edgar:mock_sec_filing_search",
      "live": null
    },
    "source_tier": 1,
    "cache_ttl_s": 86400,
    "fallbacks": ["web_search", "vector_db_search"],
    "domains": ["financials", "risk"],
    "output_schema": {
      "type": "object",
      "required": ["ticker", "cik", "filing_type", "filing_date", "accession_number", "url", "sections"],
      "properties": {
        "ticker": {"type": "string"},
        "cik": {"type": "string", "pattern": "^\\d{10}$"},
        "company_name": {"type": "string"},
        "filing_type": {"type": "string"},
        "filing_date": {"type": "string"},
        "period_of_report": {"type": "string"},
        "accession_number": {"type": "string", "pattern": "^\\d{10}-\\d{2}-\\d{6}$"},
        "url": {"type": "string"},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "title", "text"],
            "properties": {
              "item": {"type": "string"},
              "title": {"type": "string"},
              "text": {"type": "string"}
            }
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
