# Copy this file to .env and fill in the values you have. .env is git-ignored: never commit keys.
# Every service below is free and needs no credit card.

# ---------------------------------------------------------------------------------------------
# LLM providers, tried in this order: Gemini -> Groq -> Ollama. You need at least one.
# ---------------------------------------------------------------------------------------------

# Google Gemini, free tier. Sign in at https://aistudio.google.com/apikey and click "Create API key".
GEMINI_API_KEY=

# Groq, free tier (optional backup). Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Ollama needs no key. Install it from https://ollama.com and run:  ollama pull qwen2.5:3b

# Optional paid providers, only used if you add them to ARA_PROVIDER_ORDER:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------------------------

# SEC EDGAR requires a contact email in the User-Agent of every request (no account needed).
SEC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------------------------
# Run options (all optional; defaults live in config/default.toml)
# ---------------------------------------------------------------------------------------------

# mock  = no network, scripted LLM + mock data (tests)
# local = Ollama only + live data
# free  = Gemini -> Groq -> Ollama + live data (default)
# ARA_MODE=free

# Tool data: mock or live. Defaults to live unless ARA_MODE=mock.
# Live data tools arrive on Day 5; until then use mock.
ARA_DATA_MODE=mock

# Override the provider order or a model name:
# ARA_PROVIDER_ORDER=gemini,groq,ollama
# ARA_GEMINI_MODEL=gemini-3.6-flash
# ARA_GEMINI_REASONING_EFFORT=minimal
# ARA_GROQ_MODEL=llama-3.3-70b-versatile
# ARA_OLLAMA_MODEL=qwen2.5:3b

# ARA_LOG_LEVEL=INFO
